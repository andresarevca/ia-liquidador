# ============================================================
#  ia-liquidador — variables de entorno
#  Copia este archivo a .env y completa los valores
# ============================================================

# API key de Google Gemini (requerida)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Clave compartida entre el backend Django y este servicio.
# Dejar vacío para deshabilitar autenticación (solo desarrollo).
API_KEY=clave_compartida_secreta

# Ruta dentro del contenedor donde se persiste el vector store (ChromaDB).
VECTOR_DB_PATH=/app/vector_db

# Directorio temporal para archivos subidos en cada petición.
UPLOAD_DIR=/tmp/ia-liquidador

# Tamaño máximo permitido por archivo (en MB).
MAX_FILE_SIZE_MB=20

# Orígenes CORS permitidos (coma-separados).
# En producción usa la URL real del backend Django.
CORS_ORIGINS=http://localhost:8000
